# Ignore Intermediate files
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Ignore Intermediate plugin files
/Plugins/*/Intermediate
/Plugins/Developer/*/Intermediate

# Ignore plugin binaries
/Plugins/**/Binaries

# Keep MetaMovementSDK_Utility prebuilt native libraries; build output stays ignored.
!/Plugins/MetaMovementSDK_Utility/Binaries/
/Plugins/MetaMovementSDK_Utility/Binaries/**
!/Plugins/MetaMovementSDK_Utility/Binaries/**/
!/Plugins/MetaMovementSDK_Utility/Binaries/**/MetaMovementSDK_Utility.*
!/Plugins/MetaMovementSDK_Utility/Binaries/**/libMetaMovementSDK_Utility.so

# IDEs
.vs/
.vscode/*
.vsconfig
.idea/

# Solution file
*.sln

# Meta Quest agentic tooling: keep VS Code/Cursor workspace recommendations
!.vscode/extensions.json
!.vscode/mcp.json
